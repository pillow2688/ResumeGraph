# Safe local-development placeholders. Never put production secrets in this file.
RESUMEGRAPH_ENVIRONMENT=development
RESUMEGRAPH_LOG_LEVEL=INFO
RESUMEGRAPH_DATABASE_URL=postgresql+asyncpg://resumegraph:resumegraph-local-only@127.0.0.1:5432/resumegraph
RESUMEGRAPH_REDIS_URL=redis://127.0.0.1:6379/0
RESUMEGRAPH_READINESS_TIMEOUT_SECONDS=1.0
RESUMEGRAPH_DEPENDENCY_TIMEOUT_SECONDS=3.0
RESUMEGRAPH_ADMIN_SESSION_COOKIE_NAME=resumegraph_admin_session
RESUMEGRAPH_ADMIN_SESSION_TTL_SECONDS=28800
# Local HTTP development only. Production startup requires this to be true and HTTPS enabled.
RESUMEGRAPH_COOKIE_SECURE=false
RESUMEGRAPH_ADMIN_LOGIN_MAX_FAILURES=5
RESUMEGRAPH_ADMIN_LOGIN_WINDOW_SECONDS=300
# Safe local placeholder only. Generate and inject a separate secret in each deployment.
RESUMEGRAPH_ACCESS_TOKEN_PEPPER=local-development-access-token-pepper-change-me
RESUMEGRAPH_RECRUITER_SESSION_COOKIE_NAME=resumegraph_recruiter_session
RESUMEGRAPH_RECRUITER_SESSION_TTL_SECONDS=14400
RESUMEGRAPH_ACCESS_EXCHANGE_FAILURE_LIMIT=10
RESUMEGRAPH_ACCESS_EXCHANGE_FAILURE_WINDOW_SECONDS=600
RESUMEGRAPH_MARKDOWN_MAX_BYTES=1048576
# Paragraph-aware secondary split target. A single indivisible paragraph may exceed it.
RESUMEGRAPH_CHUNK_MAX_CHARACTERS=2000

# Docker Compose development values.
POSTGRES_DB=resumegraph
POSTGRES_USER=resumegraph
POSTGRES_PASSWORD=resumegraph-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
